# ============================================
# Financiera Nuevo Progreso - Variables de Entorno
# ============================================
# Copia este archivo a .env y completa los valores.
# NO subas el archivo .env al repositorio.

# --------------------------------------------
# Base de datos (OBLIGATORIO)
# --------------------------------------------
# PostgreSQL connection string.
# Formato: postgresql://usuario:password@host:puerto/nombre_db
# Ejemplo local: postgresql://postgres:mi_clave@localhost:5432/financiera_np
# Ejemplo Railway: postgresql://user:pass@containers-us-west-xxx.railway.app:7654/railway
DATABASE_URL=postgresql://usuario:password@localhost:5432/financiera_np

# --------------------------------------------
# Flask Web
# --------------------------------------------
# Clave secreta para sesiones y CSRF.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-hash-seguro-y-aleatorio

# Puerto para desarrollo local (el Procfile usa $PORT en producción)
PORT=5000

# --------------------------------------------
# Desarrollo
# --------------------------------------------
# Descomenta para habilitar modo debug (NO usar en producción)
# FLASK_DEBUG=1

# --------------------------------------------
# WhatsApp / Evolution API
# --------------------------------------------
# URL de tu instancia de Evolution API (Docker o servidor)
EVOLUTION_API_URL=http://localhost:8080

# API Key generada en Evolution API (settings > API Key)
EVOLUTION_API_KEY=tu-api-key-aqui
